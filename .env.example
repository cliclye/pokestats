# Copy to .env.local — all keys below are free tiers

# Optional: https://dev.pokemontcg.io/ — free key raises rate limits
POKEMONTCG_API_KEY=

# Free Supabase project (required for durable/public deploy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: prefer service role for server writes; otherwise JOBS_SECRET + RPC
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for GitHub Actions / Vercel Cron / local jobs
# Must match private.app_secrets.JOBS_SECRET in Supabase (used by /api/jobs/run + RPC)
JOBS_SECRET=dev-local-secret
# Optional alias used by Vercel Cron Authorization header
CRON_SECRET=

# Twilio SMS for Web Stock text reminders (https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional public site URL used in unsubscribe links
NEXT_PUBLIC_APP_URL=https://pokestats-iota.vercel.app
